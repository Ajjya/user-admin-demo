# Copy to .env and change the passwords: cp .env.example .env
# Use URL-safe characters in passwords (letters, digits, - _ .): they are embedded in MONGODB_URI.

# MongoDB root account (used only by the image's init scripts).
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-root

# Least-privilege application account (readWrite on MONGO_APP_DB only).
MONGO_APP_DB=user_admin
MONGO_APP_USERNAME=user_admin_app
MONGO_APP_PASSWORD=change-me-app

# Application
APP_PORT=3000
SESSION_TTL_HOURS=24
LOG_LEVEL=info

# Optional demo data, created on startup only when the database has no users:
# admin@example.com plus 20 users (2 inactive), all with SEED_ADMIN_PASSWORD
# (a temporary password for the 20 users).
SEED_DEMO_DATA=false
SEED_ADMIN_PASSWORD=change-me-demo

# Only for `yarn dev` outside Docker (uncomment the mongo port mapping in docker-compose.yml):
# MONGODB_URI=mongodb://user_admin_app:change-me-app@localhost:27017/user_admin?authSource=user_admin
# MONGODB_DB=user_admin
